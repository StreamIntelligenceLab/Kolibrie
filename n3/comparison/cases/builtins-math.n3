@prefix : <http://example.org/math#> .

:a :n 7 . :b :n 2 . :c :n 2.5 . :d :n 1e2 . :big :n 123456789012345678901234567890 .

{ :a :n ?x . :b :n ?y . (?x ?y) math:sum ?s } => { :sum :is ?s } .
{ :a :n ?x . :b :n ?y . (?x ?y) math:difference ?s } => { :difference :is ?s } .
{ :a :n ?x . :c :n ?y . (?x ?y) math:product ?s } => { :product :is ?s } .
{ :a :n ?x . :b :n ?y . (?x ?y) math:quotient ?s } => { :quotient :is ?s } .
{ :a :n ?x . :b :n ?y . (?x ?y) math:integerQuotient ?s } => { :integerQuotient :is ?s } .
{ :a :n ?x . :b :n ?y . (?x ?y) math:remainder ?s } => { :remainder :is ?s } .
{ :big :n ?x . (?x ?x) math:product ?s } => { :bigSquare :is ?s } .
{ (2 100) math:exponentiation ?p } => { :twoTo100 :is ?p } .
{ (2 ?e) math:exponentiation 1024 } => { :log2of1024 :is ?e } .
{ :c :n ?x . ?x math:negation ?y } => { :negated :is ?y } .
{ ?y math:negation -7 } => { :unnegated :is ?y } .
{ -3.7 math:absoluteValue ?y } => { :abs :is ?y } .
{ 2.5 math:rounded ?y } => { :rounded :is ?y } .
{ 0 math:cos ?y } => { :cos0 :is ?y } .
{ ?x math:sin 0 } => { :asin0 :is ?x } .
{ :d :n ?x . (?x 3) math:sum ?y } => { :doubleSum :is ?y } .
{ ?s :n ?x . ?x math:greaterThan 2 } => { ?s :bigger true } .
{ ?s :n ?x . ?x math:notGreaterThan 2 } => { ?s :small true } .
{ ?s :n ?x . ?x math:equalTo 2 } => { ?s :two true } .
{ ?s :n ?x . (?x 1) math:sum 8 } => { ?s :isSeven true } .
