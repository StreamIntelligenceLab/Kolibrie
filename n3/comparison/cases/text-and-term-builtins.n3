@prefix : <http://example.org/t#> .
{ "hello world" string:matches "^h.*d$" . "abc" string:notMatches "x" . ("a-b-c" "-" "+") string:replace ?r . ("id=42;" "id=([0-9]+)") string:scrape ?n . "abc" crypto:sha ?h . :x log:uri ?u . ?i log:uri "http://example.org/t#y" . ?p log:dtlit "7"^^xsd:integer . ("hi" "en") log:langlit ?l . { :a :b :c } log:rawType ?f . ("2024-03-01"^^xsd:date "2024-02-28"^^xsd:date) math:difference ?d . "2021-07-07T10:20:30Z" time:year ?yr . "2021-07-07T10:20:30Z" time:minute ?mi } => { :r :r ?r ; :n ?n ; :h ?h ; :u ?u ; :i ?i ; :p ?p ; :l ?l ; :f ?f ; :d ?d ; :yr ?yr ; :mi ?mi } .
