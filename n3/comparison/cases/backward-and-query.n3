@prefix : <http://example.org/bq#> .

:a :parent :b . :b :parent :c . :c :parent :d .
:alice :age 30 . :bob :age 15 .

{ ?x :ancestor ?y } <= { ?x :parent ?y } .
{ ?x :ancestor ?z } <= { ?x :parent ?y . ?y :ancestor ?z } .
{ ?p :adult true } <= { ?p :age ?a . ?a math:notLessThan 18 } .
{ (?n) :double ?d } <= { (?n 2) math:product ?d } .

{ :a :ancestor ?who } => { :a :reaches ?who } .
{ ?p :adult true } => { ?p a :Adult } .
{ (21) :double ?d } => { :doubled :is ?d } .
{ ?x :ancestor :d . (?y { ?y :ancestor :d } ?all) log:collectAllIn ?scope . ?all list:length ?n } => { :d :ancestorCount ?n } .

{ ?p a :Adult } log:query { ?p :status :grownUp } .
{ :a :reaches ?x } log:query { :answer :reaches ?x } .
