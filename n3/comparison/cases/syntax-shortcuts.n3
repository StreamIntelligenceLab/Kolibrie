@prefix : <http://example.org/syntax#> .
PREFIX ex: <http://example.org/other#>

:alice :child :bob , :carol ; :age 30 .
:bob is :child of :dave .
:alice!:child :likes :tea .
:x :label "plain", "tagged"@en, "typed"^^ex:T, """long
string""", 1.5, 1e3, -7, true .
:x = :y .

{ ?p :child ?c } => { ?c :parent ?p } .
{ ?s :likes ?o } => { ?s :drinks ?o } .
{ :x :label ?l } => { :copy :label ?l } .
{ :x <http://www.w3.org/2002/07/owl#sameAs> ?y } => { ?y :same :x } .
