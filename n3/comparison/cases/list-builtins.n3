@prefix : <http://example.org/lists#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

:native :items (3 1 2) .
:chain :items _:c1 .
_:c1 rdf:first 10 ; rdf:rest _:c2 .
_:c2 rdf:first 20 ; rdf:rest rdf:nil .
:words :items ("pear" "apple" "fig") .

{ ?s :items ?l . ?l list:length ?n } => { ?s :length ?n } .
{ ?s :items ?l . ?l list:first ?f . ?l list:last ?z } => { ?s :ends (?f ?z) } .
{ ?s :items ?l . ?l list:rest ?r } => { ?s :rest ?r } .
{ ?s :items ?l . ?l math:sum ?t } => { ?s :total ?t } .
{ ?s :items ?l . ?l list:member ?m } => { ?s :has ?m } .
{ ?s :items ?l . ?l list:sort ?o } => { ?s :sorted ?o } .
{ ?s :items ?l . ?l list:reverse ?o } => { ?s :reversed ?o } .
{ ?s :items ?l . ?l list:iterate (?i ?m) . ?i math:greaterThan 0 } => { ?s :later ?m } .
{ ?s :items ?l . (?l 1) list:memberAt ?m } => { ?s :second ?m } .
{ ?s :items ?l . (?l 1) list:remove ?o } => { ?s :withoutOne ?o } .
{ ?s :items ?l . ?l list:notMember 2 } => { ?s :lacksTwo true } .
{ ?s :items ?l . ?l list:firstRest (?h ?t) } => { ?s :head ?h ; :tail ?t } .
{ (?h ?t) list:firstRest (1 2 3) } => { :built :head ?h ; :tail ?t } .
{ ((1 2) (3) ()) list:append ?all } => { :appended :is ?all } .
{ ((?a) ?b) list:append (7 8 9) } => { :split :head ?a ; :rest ?b } .
{ ?x list:in (:a :b) } => { ?x :inList true } .
{ ?l rdf:first 3 } => { ?l :startsWithThree true } .
{ :native :items ?l . ?l rdf:rest ?r . ?r rdf:first ?second } => { :native :viaRdf ?second } .
