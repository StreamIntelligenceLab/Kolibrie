@prefix : <http://example.org/scoped#> .

:alice :knows :bob , :carol .
:bob :knows :carol .
:dave :knows :alice .
:carol a :Vegan .
:alice :claims { :bob :age 30 . :bob :likes :tea } .

{ ?p :knows ?q . ?scope log:notIncludes { ?q :knows ?p } } => { ?p :oneWay ?q } .
{ ?p :knows ?any . (?q { ?p :knows ?q } ?all) log:collectAllIn ?scope . ?all list:length ?n } => { ?p :knowsCount ?n } .
{ ?p :knows ?any . ({ ?p :knows ?q } { ?q a :Vegan }) log:forAllIn ?scope } => { ?p :onlyKnowsVegans true } .
{ ?p :claims ?f . ?f log:includes { ?who :age ?a } } => { ?p :claimsAge (?who ?a) } .
{ ?p :claims ?f . ?f log:notIncludes { ?who :likes :coffee } } => { ?p :neverClaimsCoffee true } .
{ :alice :claims ?f . ({ :x :y :z } ?f) log:conjunction ?g } => { :merged :is ?g } .
{ { :a :p :b . { ?s :p ?o } => { ?o :p ?s } } log:conclusion ?c } => { :closed :is ?c } .
{ ?scope log:includes { :carol a :Vegan } } => { :carol :isVegan true } .
